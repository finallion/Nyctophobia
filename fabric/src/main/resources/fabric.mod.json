{
  "schemaVersion": 1,
  "id": "nyctophobia",
  "version": "${version}",

  "name": "Nyctophobia",
  "description": "Spooky, foggy, creepy and dark biomes for your Minecraft world",
  "authors": [
    "LithiumPlus"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/nyctophobia",
    "sources": "https://github.com/finallion/Nyctophobia",
    "issues": "https://github.com/finallion/Nyctophobia/issues"
  },

  "license": "GPL-3.0-only",
  "icon": "assets/nyctophobia/nyctophobia.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "com.lion.nyctophobia.fabric.NyctophobiaFabric"
    ],
    "fabric-datagen": [
      "com.lion.nyctophobia.data.NDataGen"
    ],
    "terrablender": [
      "com.lion.nyctophobia.fabric.NyctophobiaFabric"
    ],
    "client": [
      "com.lion.nyctophobia.fabric.NyctophobiaFabricClient"
    ]
  },
  "mixins": [
    "nyctophobia-fabric.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": ">=26.1.2 <26.2",
    "java": ">=25",
    "terrablender": ">=26.1.2.0.3"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.donate": "https://www.patreon.com/cw/LithiumPlus"
      }
    }
  }
}
